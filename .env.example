# PayFlow Configuration

# Server
PORT=8080
LOG_LEVEL=INFO
ENVIRONMENT=development

# PostgreSQL Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/payflow?sslmode=disable
DATABASE_MAX_CONNS=25
DATABASE_MIN_CONNS=5
DATABASE_MAX_CONN_LIFETIME=30m
DATABASE_MAX_CONN_IDLE=5m

# Background Outbox Worker
WORKER_ENABLED=true
WORKER_POLL_INTERVAL=1s
WORKER_BATCH_SIZE=20

# Idempotency
IDEMPOTENCY_EXPIRY_HOURS=24

# Platform Fee (2.9% + 30 cents)
PLATFORM_FEE_BPS=290
PLATFORM_FEE_FIXED_MINOR=30
